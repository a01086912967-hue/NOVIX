# ── 필수 ──
# 디스코드 개발자 포털 > Bot > Reset Token
DISCORD_TOKEN=여기에_봇_토큰
# Railway PostgreSQL (Railway에서는 Add Reference로 자동 연결)
DATABASE_URL=postgresql://user:pass@host:5432/railway
# 내 디스코드 유저 ID (/프리미엄 지급, /개발자 권한). 여러 명이면 쉼표로
BOT_OWNER_ID=내_디스코드_ID

# ── 웹 대시보드 (임베드 꾸미기 · 자동 메시지) ──
# 개발자 포털 > OAuth2 > Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 사이트 주소 (끝에 / 없이). 도메인 연결 전에는 Railway 주소
PUBLIC_URL=https://novix.up.railway.app
# 아무 긴 랜덤 문자열 (로그인 쿠키 서명용, 절대 공유 금지)
SESSION_SECRET=
# PORT는 Railway가 자동으로 넣어줘요

# ── 웹 인증 (IP·부계정·VPN 차단) ──
# VPN 검사: https://proxycheck.io 무료 가입 → API 키 (키 없으면 하루 100회, 있으면 1,000회)
PROXYCHECK_KEY=
# 사람 확인(봇 방지) 체크박스: Cloudflare 대시보드 → Turnstile → 사이트 추가
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Cloudflare 프록시(주황 구름)를 켠 뒤에만 true (진짜 접속 IP를 읽기 위해)
BEHIND_CLOUDFLARE=false

# ── 결제 ──
# 공식 디스코드 서버 초대 링크 (결제·문의). 구매 버튼을 누르면 여기로 안내돼요
SUPPORT_SERVER_URL=https://discord.gg/
# (참고) 아래는 계좌이체 자동 승인용 — 지금은 안 써도 돼요
# 결제 페이지에 보여줄 계좌 (GitHub에 올리지 말고 Railway에만!)
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=
# 입금 알림을 받는 주소의 비밀 키 (영어·숫자 32자 이상, 아무렇게나)
DEPOSIT_SECRET=
# (선택) 결제 알림을 받을 디스코드 채널 ID. 비우면 BOT_OWNER_ID에게 DM
PAYMENT_LOG_CHANNEL_ID=
# (선택) 주문 코드 앞글자 (영어 1~2자), 기본 N → 입금자명 예: N482홍길동
DEPOSIT_PREFIX=N
# (선택) 입금 기한 (분), 기본 30
ORDER_MINUTES=30

# ── 노래방 ──
# 유튜브 공식 검색 키: Google Cloud Console → YouTube Data API v3 사용 → 사용자 인증 정보 → API 키
YOUTUBE_API_KEY=

# ── 관리자 페이지 ──
# 로그인 기록에 IP 전체를 저장할지 (기본 false = 앞부분만)
LOG_FULL_IP=false

# ── 선택 ──
# /이미지링크 용 — 둘 중 하나만 있으면 돼요 (ImgBB 우선)
# ImgBB: https://api.imgbb.com 가입 → API 키
IMGBB_API_KEY=
# Imgur: https://api.imgur.com/oauth2/addclient (로그인 후)
IMGUR_CLIENT_ID=
